# Copy to .env next to newer_yolo_detection.py.

# The cloud server's address, for example https://agrynex-cloud-server.onrender.com
AGRYNEX_SERVER_URL=
# Must match DEVICE_TOKEN on the cloud server.
AGRYNEX_DEVICE_TOKEN=

# Optional. 0 is the first camera, or give a video file path for testing.
AGRYNEX_VIDEO_SOURCE=0
